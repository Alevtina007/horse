# Скопируйте этот файл в .env.local и заполните реальными значениями.
# .env.local НЕ коммитится в git (см. .gitignore).

# Токен доступа ВКонтакте (Standalone / Community token с правом messages).
# Получить: https://vk.com/dev/access_token
VK_ACCESS_TOKEN=

# ID диалога/пользователя, куда отправлять заявки (peer_id для messages.send).
# Для личного профиля — это ваш user_id. Для сообщества — обычно
# 2000000000 + id беседы, либо просто ваш user_id, если пишете себе.
VK_PEER_ID=

# Версия VK API. Необязательно — по умолчанию используется 5.199.
VK_API_VERSION=5.199

# Номер счётчика Яндекс.Метрики (виден в интерфейсе метрики, это не
# секрет — переменная с префиксом NEXT_PUBLIC_ специально попадает и в
# браузер). Если оставить пустым — Метрика на сайте просто не подключится.
NEXT_PUBLIC_YM_ID=
